# Copy to .env.local for local development; replace placeholders before use.
# Server-only. Never expose these in browser code or commit actual credentials.
# Local PostgreSQL only. Do NOT use the current migrations on Supabase:
# its required API-role grant hardening has NOT been implemented. See BACKEND.md.
DATABASE_URL=postgresql://rimdan_app:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/rimdan_dev
APP_ORIGIN=http://127.0.0.1:3000
APP_ENV=development
PORT=3000
# Migration owner: operator process only, never Vercel runtime.
# Prefer supplying this only to the manual migration/bootstrap process.
# MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE_WITH_LOCAL_OWNER_PASSWORD@127.0.0.1:55432/rimdan_dev
# Bootstrap is manual, local-only here, and refuses a non-empty accounts table.
# BOOTSTRAP_ADMIN_EMAIL=REPLACE_WITH_LOCAL_TEST_EMAIL
# BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_TEST_PASSWORD
# TEST_DATABASE_URL=postgresql://postgres:REPLACE_WITH_DISPOSABLE_TEST_PASSWORD@127.0.0.1:55432/postgres
# Remote integration is not approved/configured by this example. When approved,
# remote URLs require sslmode=verify-full and a separate least-privilege login.
# RIMDAN_MODE is intentionally omitted: normal builds use authenticated server mode.
