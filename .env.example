# Server-only. Never prefix these with PUBLIC_ or place them in browser files.
DATABASE_URL=postgresql://rimdan_app:REPLACE_ME@YOUR_POOLED_HOST/rimdan?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://OWNER:REPLACE_ME@YOUR_DIRECT_HOST/rimdan?sslmode=verify-full
APP_ORIGIN=https://YOUR_PROJECT.vercel.app
# Only for local HTTP development (production must use HTTPS):
# APP_ENV=development
# APP_ORIGIN=http://127.0.0.1:3000
# Bootstrap uses the migration-owner connection, only with an empty accounts table.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=SET_SECURELY_NOT_IN_THIS_FILE
